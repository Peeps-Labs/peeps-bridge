{
  "name": "@peepsai/bridge",
  "version": "0.1.0",
  "description": "Runs a Peeps agent's browser tools on your machine, so Peeps can explore the app you are building at localhost.",
  "license": "MIT",
  "author": "Peeps Labs",
  "homepage": "https://github.com/Peeps-Labs/peeps-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peeps-Labs/peeps-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Peeps-Labs/peeps-bridge/issues"
  },
  "keywords": [
    "peeps",
    "playwright",
    "mcp",
    "testing"
  ],
  "type": "module",
  "bin": {
    "peeps-bridge": "dist/bin.js"
  },
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "test:coverage": "node --test --import tsx --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-functions=90 --test-coverage-branches=85 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.69",
    "playwright-core": "1.59.0-alpha-1774912654000"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
